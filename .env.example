# Convex
VITE_CONVEX_URL=your_convex_url_here
VITE_CONVEX_SITE_URL=your_convex_site_url_here

# Clerk (auth)
# Publishable key must be set both for the frontend build (VITE_-prefixed,
# read by src/main.tsx) and set server-side on the Convex deployment so the
# JWT issuer domain in convex/auth.config.ts can be resolved.
# Get these from the Clerk dashboard: https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here

# Set server-side on the Convex deployment via:
#   bunx convex env set CLERK_JWT_ISSUER_DOMAIN https://your-instance.clerk.accounts.dev
# Use a separate value per Convex deployment (dev vs. prod) matching that
# deployment's Clerk instance (Development vs. Production) — do not set this
# in a .env file, Convex reads it from its own deployment environment.
# CLERK_JWT_ISSUER_DOMAIN=https://your-instance.clerk.accounts.dev

# CORS - Required for local development
# Comma-separated list of allowed origins for cross-origin requests
# Omitting this will block all CORS requests
ALLOWED_ORIGINS=http://localhost:5173

# Cryptographically secure 32-byte key for PII encryption (e.g., openssl rand -hex 32)
PII_ENCRYPTION_KEY="GENERATE_SECURE_32_BYTE_HEX_KEY_HERE"